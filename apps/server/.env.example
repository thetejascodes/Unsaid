PORT=8000
DATABASE_URL=postgresql://admin:admin@localhost:5432/unsaid
VALKEY_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional: required only when phone OTP is enabled.
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_API_KEY_SID=replace-with-twilio-api-key-sid
TWILIO_API_KEY_SECRET=replace-with-twilio-api-key-secret
TWILIO_FROM_NUMBER=replace-with-twilio-from-number
TWILIO_TO_NUMBER=replace-with-twilio-to-number

NVIDIA_API_KEY=replace-with-nvidia-api-key
MODERATION_MODEL=meta/muse-glimmer-30b
baseURL=https://integrate.api.nvidia.com/v1
OTP_STUB_MODE=true
