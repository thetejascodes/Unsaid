PORT=8000
DATABASE_URL=postgresql://admin:admin@localhost:5432/unsaid
VALKEY_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Twilio Configuration (required for phone OTP authentication)
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_API_KEY_SID=replace-with-twilio-api-key-sid
TWILIO_API_KEY_SECRET=replace-with-twilio-api-key-secret
TWILIO_FROM_NUMBER=replace-with-twilio-from-number
TWILIO_TO_NUMBER=replace-with-twilio-to-number

# OpenRouter AI Configuration
OPENROUTER_API_KEY=replace-with-openrouter-api-key
MODERATION_MODEL=meta-llama/llama-3.1-8b-instruct
ICEBREAKER_MODEL=meta-llama/llama-3.1-8b-instruct
AI_BASE_URL=https://openrouter.ai/api/v1
